ninja_required_version = 1.3
cxx = c++
nvcc = /usr/bin/nvcc

cflags = -pthread -B /data1/simroop/programs/miniconda3/envs/sculpt3d/compiler_compat -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /data1/simroop/programs/miniconda3/envs/sculpt3d/include -fPIC -O2 -isystem /data1/simroop/programs/miniconda3/envs/sculpt3d/include -fPIC -I/data1/simroop/programs/miniconda3/envs/sculpt3d/lib/python3.11/site-packages/torch/include -I/data1/simroop/programs/miniconda3/envs/sculpt3d/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/data1/simroop/programs/miniconda3/envs/sculpt3d/include/python3.11 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=chamfer -std=c++17
cuda_cflags = -I/data1/simroop/programs/miniconda3/envs/sculpt3d/lib/python3.11/site-packages/torch/include -I/data1/simroop/programs/miniconda3/envs/sculpt3d/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/data1/simroop/programs/miniconda3/envs/sculpt3d/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=chamfer -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /data1/simroop/github/PartCrafter/extensions/chamfer_dist/build/temp.linux-x86_64-cpython-311/chamfer.o: cuda_compile /data1/simroop/github/PartCrafter/extensions/chamfer_dist/chamfer.cu
build /data1/simroop/github/PartCrafter/extensions/chamfer_dist/build/temp.linux-x86_64-cpython-311/chamfer_cuda.o: compile /data1/simroop/github/PartCrafter/extensions/chamfer_dist/chamfer_cuda.cpp








